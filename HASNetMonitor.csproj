<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Two targets, one source tree:
         net11.0-windows - the development build and the tests.
         net48            - ships as a single small exe that runs on a stock Windows
                            install with nothing to download, because .NET Framework
                            4.8 is a Windows component. -->
    <TargetFrameworks>net11.0-windows;net48</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>HASNetMonitor</RootNamespace>
    <AssemblyName>HASNetMonitor</AssemblyName>
    <!-- The version shown in the About box and in the exe's file properties.
         Core/AppInfo.cs reads it back from the assembly. -->
    <Version>1.0.0</Version>
    <Product>HAS NetMonitor</Product>
    <Authors>Md Hanif Ali Sohag</Authors>
    <Company>Md Hanif Ali Sohag</Company>
    <!-- Shown as "Description" in Explorer's file properties. -->
    <AssemblyTitle>HAS NetMonitor</AssemblyTitle>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- The green/red activity mark shown in Explorer and Task Manager.
         Regenerate with: python tools/make_icon.py -->
    <ApplicationIcon>Assets\HASNetMonitor.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0-windows'">
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- .NET Framework has no ApplicationHighDpiMode; App.config carries the same
         setting (see App.config) so the settings dialog stays crisp when scaled. -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also embedded as a resource so the settings dialog, the tray icon and the
         exe icon are all the same mark, wherever the exe lives. -->
    <EmbeddedResource Include="Assets\HASNetMonitor.ico" LogicalName="HASNetMonitor.AppIcon.ico" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- Lets the SDK build for .NET Framework without that developer pack installed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- The in-box JSON serialiser used instead of System.Text.Json. -->
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test project lives inside this folder; keep its sources out of the app. -->
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HASNetMonitor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every file may use the shared helpers (Numeric, Elapsed, ConfigJson) without a
         per-file using, identically on both targets. -->
    <Using Include="HASNetMonitor.Core" />
  </ItemGroup>

</Project>
